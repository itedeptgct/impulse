{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./src/*"],
			"@auth/*": ["./src/features/auth/*"],
			"@lib/*": ["./src/lib/*"],
			"@theme/*": ["./src/theme/*"]
		}
	},
	"include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "src/types/global.d.ts"]
}
