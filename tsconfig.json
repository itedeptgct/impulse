{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./src/*"],
			"@admin/*": ["./src/features/admin/*"],
			"@auth/*": ["./src/features/auth/*"],
			"@lib/*": ["./src/lib/*"],
			"@theme/*": ["./src/theme/*"]
		},
		"allowImportingTsExtensions": true,
		"noUncheckedSideEffectImports": false,
		"types": ["@types/node", "@types/bun"]
	},
	"include": [
		"app/**/*.ts",
		"app/**/*.tsx",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.d.ts",
		"global.d.ts"
	]
}
